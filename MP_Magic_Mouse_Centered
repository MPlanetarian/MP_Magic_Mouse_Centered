def run_hotkey_daemon():
    """
    Background daemon:
    1. Immediately centers mouse cursor at login/startup.
    2. Runs follow-up centering after multi-monitor geometry settles on login.
    3. Runs an ultra-efficient listener for ALT+C.
    """
    config = load_config()
    time.sleep(1.0)
    center_cursor(config)

    # In Wayland / multi-monitor setups, compositor outputs take 2-3s to settle during desktop login
    def delayed_login_center():
        time.sleep(2.5)
        cfg = load_config()
        center_cursor(cfg)

    threading.Thread(target=delayed_login_center, daemon=True).start()

    if sys.platform == "darwin":
        run_hotkey_darwin(config)
    elif sys.platform == "win32":
        run_hotkey_win32(config)
    else:
        run_hotkey_linux(config)

def run_hotkey_darwin(config: Dict[str, Any]):
    """
    macOS dual hotkey listener:
    1. EventTap on CFRunLoop:
       Uses kCGEventTapOptionDefault to consume Alt+C and prevent the active
       window from receiving 'ç' or hiding/repositioning the mouse cursor.
    2. Fallback polling loop with CGEventSourceFlagsState & CGEventSourceKeyState.
    """
    cg = ctypes.cdll.LoadLibrary('/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices')
    cf = ctypes.cdll.LoadLibrary('/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation')

    last_trigger = [0.0]
    lock = threading.Lock()

    def trigger_hotkey():
        with lock:
            now = time.time()
            if now - last_trigger[0] < 0.35: # 350ms debounce
                return
            last_trigger[0] = now
            cfg = load_config()
            center_cursor(cfg)
            if cfg.get("sound_on_hotkey", False):
                play_happy_sound()

    # --- Listener Thread 1: CGEventTap on CFRunLoop ---
    def event_tap_thread_func():
        try:
            EventTapCallback = ctypes.CFUNCTYPE(ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint32, ctypes.c_void_p, ctypes.c_void_p)
            cg.CGEventTapCreate.argtypes = [ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_int64, EventTapCallback, ctypes.c_void_p]
            cg.CGEventTapCreate.restype = ctypes.c_void_p
            cg.CGEventTapEnable.argtypes = [ctypes.c_void_p, ctypes.c_bool]
            cg.CGEventGetIntegerValueField.argtypes = [ctypes.c_void_p, ctypes.c_uint32]
            cg.CGEventGetIntegerValueField.restype = ctypes.c_int64
            cg.CGEventGetFlags.argtypes = [ctypes.c_void_p]
            cg.CGEventGetFlags.restype = ctypes.c_ulonglong

            cf.CFMachPortCreateRunLoopSource.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int32]
            cf.CFMachPortCreateRunLoopSource.restype = ctypes.c_void_p
            cf.CFRunLoopGetCurrent.restype = ctypes.c_void_p
            cf.CFRunLoopAddSource.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
            cf.CFRunLoopRun.restype = None

            tap_ref = [None]

            @EventTapCallback
            def callback(proxy, type_, event, refcon):
                if type_ == 14: # kCGEventTapDisabledByTimeout
                    if tap_ref[0]:
                        cg.CGEventTapEnable(tap_ref[0], True)
                    return event

                if type_ == 10: # kCGEventKeyDown
                    keycode = cg.CGEventGetIntegerValueField(event, 9) # kCGKeyboardEventKeycode
                    if keycode == 8: # 'C' key on ANSI
                        flags = cg.CGEventGetFlags(event)
                        # Option/Alt key flag or device flags
                        is_alt = bool(flags & 0x00080000) or bool(flags & 0x00000060)
                        # Ensure Command is not held down (to preserve standard Cmd+C Copy)
                        is_cmd = bool(flags & 0x00100000)
                        if is_alt and not is_cmd:
                            trigger_hotkey()
                            # Return None (NULL) to consume Alt+C
                            return None
                return event

            mask = (1 << 10) # kCGEventKeyDown
            # Place tap with Default option (0) to allow swallowing Alt+C
            tap = cg.CGEventTapCreate(1, 0, 0, mask, callback, None)
            if not tap:
                tap = cg.CGEventTapCreate(0, 0, 0, mask, callback, None)
            if not tap:
                tap = cg.CGEventTapCreate(1, 0, 1, mask, callback, None)
            if not tap:
                tap = cg.CGEventTapCreate(0, 0, 1, mask, callback, None)

            if tap:
                tap_ref[0] = tap
                common_mode = ctypes.c_void_p.in_dll(cf, 'kCFRunLoopCommonModes').value
                default_mode = ctypes.c_void_p.in_dll(cf, 'kCFRunLoopDefaultMode').value
                src = cf.CFMachPortCreateRunLoopSource(None, tap, 0)
                rl = cf.CFRunLoopGetCurrent()
                cf.CFRunLoopAddSource(rl, src, common_mode)
                cf.CFRunLoopAddSource(rl, src, default_mode)
                cg.CGEventTapEnable(tap, True)
                cf.CFRunLoopRun()
        except Exception:
            pass

    t = threading.Thread(target=event_tap_thread_func, daemon=True)
    t.start()

    # --- Listener Thread 2: Polling Loop with Flags & KeyState ---
    cg.CGEventSourceKeyState.argtypes = [ctypes.c_int, ctypes.c_uint16]
    cg.CGEventSourceKeyState.restype = ctypes.c_bool
    cg.CGEventSourceFlagsState.argtypes = [ctypes.c_int]
    cg.CGEventSourceFlagsState.restype = ctypes.c_ulonglong

    was_down = False
    while True:
        try:
            f0 = cg.CGEventSourceFlagsState(0)
            f1 = cg.CGEventSourceFlagsState(1)
            flags = f0 | f1

            is_alt = bool(flags & 0x00080000) or cg.CGEventSourceKeyState(0, 58) or cg.CGEventSourceKeyState(0, 61) or cg.CGEventSourceKeyState(1, 58) or cg.CGEventSourceKeyState(1, 61)
            is_cmd = bool(flags & 0x00100000) or cg.CGEventSourceKeyState(0, 55) or cg.CGEventSourceKeyState(0, 54)

            c_down = cg.CGEventSourceKeyState(0, 8) or cg.CGEventSourceKeyState(1, 8)

            if is_alt and c_down and not is_cmd:
                if not was_down:
                    was_down = True
                    trigger_hotkey()
            else:
                was_down = False

            time.sleep(0.035)
        except (KeyboardInterrupt, SystemExit):
            break
        except Exception:
            time.sleep(0.1)

def run_hotkey_win32(config: Dict[str, Any]):
    """Windows hotkey listener using RegisterHotKey and Win32 message loop."""
    try:
        user32 = ctypes.windll.user32
        MOD_ALT = 0x0001
        MOD_NOREPEAT = 0x4000
        VK_C = 0x43
        HOTKEY_ID = 101

        user32.RegisterHotKey(None, HOTKEY_ID, MOD_ALT | MOD_NOREPEAT, VK_C)

        class MSG(ctypes.Structure):
            _fields_ = [
                ('hwnd', ctypes.c_void_p),
                ('message', ctypes.c_uint),
                ('wParam', ctypes.c_void_p),
                ('lParam', ctypes.c_void_p),
                ('time', ctypes.c_ulong),
                ('pt', ctypes.c_long * 2)
            ]

        msg = MSG()
        while user32.GetMessageW(ctypes.byref(msg), None, 0, 0) != 0:
            if msg.message == 0x0312 and msg.wParam == HOTKEY_ID: # WM_HOTKEY
                cfg = load_config()
                center_cursor(cfg)
                if cfg.get("sound_on_hotkey", False):
                    play_happy_sound()
            user32.TranslateMessage(ctypes.byref(msg))
            user32.DispatchMessageW(ctypes.byref(msg))
    except (KeyboardInterrupt, SystemExit):
        pass
    except Exception:
        while True:
            try:
                alt = bool(ctypes.windll.user32.GetAsyncKeyState(0x12) & 0x8000)
                c_key = bool(ctypes.windll.user32.GetAsyncKeyState(0x43) & 0x8000)
                if alt and c_key:
                    cfg = load_config()
                    center_cursor(cfg)
                    time.sleep(0.3)
                time.sleep(0.04)
            except (KeyboardInterrupt, SystemExit):
                break
            except Exception:
                time.sleep(0.1)

def run_hotkey_linux(config: Dict[str, Any]):
    """Linux hotkey listener for X11 & Wayland fallback."""
    is_wayland = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("XDG_SESSION_TYPE") == "wayland")

    x11 = None
    for lib_name in ["libX11.so.6", "libX11.so"]:
        try:
            x11 = ctypes.cdll.LoadLibrary(lib_name)
            break
        except Exception:
            continue

    if x11:
        disp = None
        try:
            x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
            x11.XOpenDisplay.restype = ctypes.c_void_p
            x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
            x11.XDefaultRootWindow.restype = ctypes.c_ulong
            x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
            x11.XKeysymToKeycode.restype = ctypes.c_ubyte
            x11.XGrabKey.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_int]
            x11.XGrabKey.restype = ctypes.c_int
            x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
            x11.XNextEvent.restype = ctypes.c_int
            x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
            x11.XCloseDisplay.restype = ctypes.c_int

            ErrorHandler = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)
            @ErrorHandler
            def _err_handler(d, e):
                return 0
            x11.XSetErrorHandler.argtypes = [ErrorHandler]
            x11.XSetErrorHandler.restype = ctypes.c_void_p
            x11.XSetErrorHandler(_err_handler)

            disp = x11.XOpenDisplay(None)
        except Exception:
            disp = None

        if disp:
            try:
                root = x11.XDefaultRootWindow(disp)
                keycode = x11.XKeysymToKeycode(disp, 0x63) # XK_c
                Mod1Mask = 8
                modifiers = [Mod1Mask, Mod1Mask | 2, Mod1Mask | 16, Mod1Mask | 18]
                for mod in modifiers:
                    x11.XGrabKey(disp, keycode, mod, root, True, 1, 1)

                class XEvent(ctypes.Structure):
                    _fields_ = [('type', ctypes.c_int), ('pad', ctypes.c_byte * 192)]

                event = XEvent()
                while True:
                    x11.XNextEvent(disp, ctypes.byref(event))
                    if event.type == 2: # KeyPress
                        cfg = load_config()
                        center_cursor(cfg)
                        if cfg.get("sound_on_hotkey", False):
                            play_happy_sound()
            except (KeyboardInterrupt, SystemExit):
                if disp:
                    x11.XCloseDisplay(disp)
                return
            except Exception:
                if disp:
                    x11.XCloseDisplay(disp)

    while True:
        try:
            time.sleep(1)
        except (KeyboardInterrupt, SystemExit):
            break

