def configure_target_monitor_menu():
    """Interactive menu to select and save target monitor."""
    config = load_config()
    monitors = get_monitors()

    print("\n" + "-" * 60)
    print("           CONFIGURE TARGET MONITOR")
    print("-" * 60)
    print(f"Current setting: {config.get('target_monitor', 'primary')}\n")
    print("Available Displays:")
    print("  [P] Primary / Main Screen (Default)")
    for m in monitors:
        idx = m["index"]
        name = m["name"]
        w, h = m["width"], m["height"]
        primary_str = " (Primary)" if m.get("is_primary") else ""
        print(f"  [{idx}] {name}: {w}x{h} at ({m['x']},{m['y']}){primary_str}")

    print("  [C] Cancel / Back")
    print("-" * 60)
    choice = input("Enter choice [P, 0, 1, ...]: ").strip()

    if choice.upper() == 'P':
        config["target_monitor"] = "primary"
        save_config(config)
        print("[+] Target monitor set to: Primary Display")
        center_cursor(config)
    elif choice.isdigit():
        idx = int(choice)
        if any(m["index"] == idx for m in monitors):
            config["target_monitor"] = idx
            save_config(config)
            print(f"[+] Target monitor set to: Display {idx}")
            center_cursor(config)
        else:
            print("[!] Invalid display index.")
    elif choice.upper() == 'C':
        print("[*] Configuration unchanged.")
    else:
        print("[!] Invalid option.")

def show_status():
    """Displays current system status, monitor details, and service status."""
    config = load_config()
    monitors = get_monitors()
    target = get_target_monitor(config)
    installed = is_service_installed()
    running = is_service_running()

    print("\n" + "=" * 65)
    print("             MP MAGIC MOUSE CENTERED - STATUS")
    print("=" * 65)
    print(f"Operating System   : {sys.platform} ({'Wayland' if os.environ.get('WAYLAND_DISPLAY') else 'Standard'})")
    print(f"Config File        : {get_config_path()}")
    print(f"Target Monitor     : {config.get('target_monitor', 'primary')} -> [{target.get('name', 'Unknown')}]")
    print(f"Target Center Coords: X={target.get('center_x')}, Y={target.get('center_y')}")
    print(f"Shortcut Key       : {config.get('shortcut', 'Alt+C')}")
    print(f"Sound Enabled      : {config.get('sound_enabled', True)}")
    print(f"Sound on Alt+C     : {config.get('sound_on_hotkey', False)}")
    print(f"Service Installed  : {'YES' if installed else 'NO'}")
    print(f"Service Running    : {'ACTIVE / RUNNING' if (running or installed) else 'STOPPED'}")
    print("-" * 65)
    print("Connected Displays:")
    for m in monitors:
        main_flag = " [Primary]" if m.get("is_primary") else ""
        print(f"  * Display {m['index']}: {m['width']}x{m['height']} at ({m['x']},{m['y']}){main_flag}")
    print("=" * 65 + "\n")

def run_interactive_menu():
    """Main CLI interactive menu loop."""
    while True:
        config = load_config()
        installed = is_service_installed()

        print("\n" + "=" * 65)
        print("                 MP MAGIC MOUSE CENTERED")
        print("=" * 65)
        print(" [1] Center Mouse Cursor Now")
        print(" [2] Configure Target Monitor (Multi-Display Setup)")
        print(f" [3] Install / Enable Background Login Service & Hotkey (Alt+C) [{'ACTIVE' if installed else 'DISABLED'}]")
        print(" [4] Remove & Disable Mouse Centering Service")
        print(" [5] Test Happy Alert Sound")
        print(f" [6] Toggle Alert Sound on Shortcut (Alt+C) [{'ENABLED' if config.get('sound_on_hotkey', False) else 'DISABLED'}]")
        print(" [7] View Current Configuration & Service Status")
        print(" [0] Exit")
        print("=" * 65)

        try:
            choice = input("Select an option [0-7]: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

        if choice == "1":
            success, target = center_cursor(config)
            if success:
                print(f"[OK] Mouse cursor centered on {target.get('name')} at ({target['center_x']}, {target['center_y']})")
            else:
                print("[!] Failed to move mouse cursor.")
        elif choice == "2":
            configure_target_monitor_menu()
        elif choice == "3":
            print("[*] Installing background login service...")
            if install_background_service():
                config["service_installed"] = True
                save_config(config)
                print("[+] Background service installed and enabled!")
                print("[+] Cursor will automatically center on login, and ALT+C is active.")
            else:
                print("[!] Failed to install background service.")
        elif choice == "4":
            print("[*] Removing and disabling background service...")
            if remove_background_service():
                config["service_installed"] = False
                save_config(config)
                print("[+] Background service has been successfully removed and disabled.")
            else:
                print("[!] Encountered an issue while removing service.")
        elif choice == "5":
            print("[*] Playing happy alert sound...")
            play_happy_sound()
            print("[OK] Sound played.")
        elif choice == "6":
            curr = config.get("sound_on_hotkey", False)
            config["sound_on_hotkey"] = not curr
            save_config(config)
            print(f"[+] Sound on Alt+C is now: {'ENABLED' if not curr else 'DISABLED'}")
        elif choice == "7":
            show_status()
        elif choice == "0":
            print("Goodbye!")
            break
        else:
            print("[!] Invalid selection. Please enter a number between 0 and 7.")

# ============================================================================
# MAIN ENTRYPOINT
# ============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="MP Magic Mouse Centered - Automatically centers cursor on login and with Alt+C shortcut."
    )
    parser.add_argument("--center", action="store_true", help="Immediately center the mouse cursor and exit.")
    parser.add_argument("--daemon", action="store_true", help="Run background daemon service (centers cursor on login, listens for Alt+C).")
    parser.add_argument("--install", action="store_true", help="Install and enable permanent background login service.")
    parser.add_argument("--uninstall", action="store_true", help="Remove and disable background login service.")
    parser.add_argument("--status", action="store_true", help="Display service and configuration status.")
    parser.add_argument("--list-monitors", action="store_true", help="List all detected monitors and their geometries.")
    parser.add_argument("--set-monitor", type=str, help="Set target monitor ('primary' or display index 0, 1, ...).")
    parser.add_argument("--play-sound", action="store_true", help="Play the generated happy alert sound.")
    parser.add_argument("--menu", action="store_true", help="Launch interactive CLI menu directly.")

    args = parser.parse_args()
    config = load_config()

    if args.daemon:
        run_hotkey_daemon()
        return

    if args.center:
        success, target = center_cursor(config)
        if success:
            print(f"Cursor centered on {target.get('name')} at ({target['center_x']}, {target['center_y']})")
        else:
            sys.exit(1)
        return

    if args.install:
        if install_background_service():
            config["service_installed"] = True
            save_config(config)
            print("Background service installed and enabled.")
        else:
            sys.exit(1)
        return

    if args.uninstall:
        if remove_background_service():
            config["service_installed"] = False
            save_config(config)
            print("Background service successfully removed and disabled.")
        else:
            sys.exit(1)
        return

    if args.status:
        show_status()
        return

    if args.list_monitors:
        monitors = get_monitors()
        print("Connected Displays:")
        for m in monitors:
            p = " [Primary]" if m.get("is_primary") else ""
            print(f"  [{m['index']}] {m['name']}: {m['width']}x{m['height']} at ({m['x']},{m['y']}){p}")
        return

    if args.set_monitor:
        val = args.set_monitor.strip()
        if val.lower() == "primary":
            config["target_monitor"] = "primary"
        else:
            try:
                config["target_monitor"] = int(val)
            except ValueError:
                config["target_monitor"] = val
        save_config(config)
        print(f"Target monitor updated to: {config['target_monitor']}")
        center_cursor(config)
        return

    if args.play_sound:
        play_happy_sound()
        return

    if not config.get("first_run_completed", False):
        handle_first_run(config)
        if sys.stdin.isatty():
            try:
                res = input("Would you like to open the CLI management menu? [Y/n]: ").strip().lower()
                if res in ("", "y", "yes"):
                    run_interactive_menu()
            except (KeyboardInterrupt, EOFError):
                pass
        return

    if sys.stdin.isatty() or args.menu:
        run_interactive_menu()
    else:
        center_cursor(config)

if __name__ == "__main__":
    main()
