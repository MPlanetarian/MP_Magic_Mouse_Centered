WINDOWS_REG_NAME = "MP_Magic_Mouse_Centered"

def install_background_service() -> bool:
    """Installs and enables the permanent background service for login."""
    py_exec = sys.executable
    script = SCRIPT_PATH

    if sys.platform == "darwin":
        try:
            os.makedirs(os.path.dirname(MACOS_PLIST_PATH), exist_ok=True)
            plist_content = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{MACOS_LAUNCHAGENT_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{py_exec}</string>
        <string>{script}</string>
        <string>--daemon</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
"""
            with open(MACOS_PLIST_PATH, "w", encoding="utf-8") as f:
                f.write(plist_content)

            uid = os.getuid()
            subprocess.run(["launchctl", "bootout", f"gui/{uid}/{MACOS_LAUNCHAGENT_LABEL}"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            res = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", MACOS_PLIST_PATH],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode != 0:
                subprocess.run(["launchctl", "load", "-w", MACOS_PLIST_PATH],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:
            return False

    elif sys.platform == "win32":
        try:
            import winreg
            pythonw = os.path.join(os.path.dirname(py_exec), "pythonw.exe")
            exec_bin = pythonw if os.path.exists(pythonw) else py_exec
            cmd = f'"{exec_bin}" "{script}" --daemon'

            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, WINDOWS_REG_KEY, 0, winreg.KEY_SET_VALUE) as key:
                winreg.SetValueEx(key, WINDOWS_REG_NAME, 0, winreg.REG_SZ, cmd)

            subprocess.Popen([exec_bin, script, "--daemon"], creationflags=subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP)
            return True
        except Exception:
            return False

    else:
        success = False
        try:
            os.makedirs(os.path.dirname(LINUX_SYSTEMD_PATH), exist_ok=True)
            unit_content = f"""[Unit]
Description=MP Magic Mouse Centered Service
After=graphical-session.target

[Service]
Type=simple
ExecStart={py_exec} {script} --daemon
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
"""
            with open(LINUX_SYSTEMD_PATH, "w", encoding="utf-8") as f:
                f.write(unit_content)

            subprocess.run(["systemctl", "--user", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            res = subprocess.run(["systemctl", "--user", "enable", "--now", LINUX_SERVICE_NAME],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                success = True
        except Exception:
            pass

        try:
            os.makedirs(os.path.dirname(LINUX_AUTOSTART_PATH), exist_ok=True)
            desktop_content = f"""[Desktop Entry]
Type=Application
Name=MP Magic Mouse Centered
Comment=Positions mouse cursor at screen center upon login and handles Alt+C
Exec={py_exec} {script} --daemon
Terminal=false
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
"""
            with open(LINUX_AUTOSTART_PATH, "w", encoding="utf-8") as f:
                f.write(desktop_content)
            success = True
        except Exception:
            pass

        try:
            is_wayland = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("XDG_SESSION_TYPE") == "wayland")
            if is_wayland:
                # GNOME Custom Shortcut
                if shutil.which("gsettings"):
                    custom_path = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mp-magic-mouse/"
                    subprocess.run(["gsettings", "set", f"org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:{custom_path}",
                                    "name", "MP Magic Mouse Centered"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    subprocess.run(["gsettings", "set", f"org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:{custom_path}",
                                    "command", f"{py_exec} {script} --center"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    subprocess.run(["gsettings", "set", f"org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:{custom_path}",
                                    "binding", "<Alt>c"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                # KDE Plasma Global Shortcut
                apps_dir = os.path.expanduser("~/.local/share/applications")
                os.makedirs(apps_dir, exist_ok=True)
                kde_desktop = os.path.join(apps_dir, "mp-magic-mouse-centered.desktop")
                with open(kde_desktop, "w", encoding="utf-8") as f:
                    f.write(f"""[Desktop Entry]
Type=Application
Name=MP Magic Mouse Centered
Comment=Positions mouse cursor at screen center
Exec={py_exec} {script} --center
Icon=input-mouse
Terminal=false
Categories=Utility;
X-KDE-Shortcuts=Alt+C
""")
                for kw in ["kwriteconfig6", "kwriteconfig5"]:
                    if shutil.which(kw):
                        subprocess.run([kw, "--file", "kglobalshortcutsrc", "--group", "services",
                                        "--group", "mp-magic-mouse-centered.desktop", "--key", "_launch",
                                        "Alt+C,Alt+C,MP Magic Mouse Centered"],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        break
        except Exception:
            pass

        if not success:
            try:
                subprocess.Popen([py_exec, script, "--daemon"], start_new_session=True)
                success = True
            except Exception:
                pass

        return success

def remove_background_service() -> bool:
    """Removes and disables the permanent background service."""
    success = False

    if sys.platform == "darwin":
        try:
            uid = os.getuid()
            subprocess.run(["launchctl", "bootout", f"gui/{uid}/{MACOS_LAUNCHAGENT_LABEL}"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["launchctl", "unload", "-w", MACOS_PLIST_PATH],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.exists(MACOS_PLIST_PATH):
                os.remove(MACOS_PLIST_PATH)
            success = True
        except Exception:
            pass

    elif sys.platform == "win32":
        try:
            import winreg
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, WINDOWS_REG_KEY, 0, winreg.KEY_SET_VALUE) as key:
                try:
                    winreg.DeleteValue(key, WINDOWS_REG_NAME)
                    success = True
                except FileNotFoundError:
                    success = True
        except Exception:
            pass

    else:
        try:
            subprocess.run(["systemctl", "--user", "disable", "--now", LINUX_SERVICE_NAME],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.exists(LINUX_SYSTEMD_PATH):
                os.remove(LINUX_SYSTEMD_PATH)
            subprocess.run(["systemctl", "--user", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            success = True
        except Exception:
            pass

        try:
            if os.path.exists(LINUX_AUTOSTART_PATH):
                os.remove(LINUX_AUTOSTART_PATH)
                success = True
        except Exception:
            pass

        try:
            if shutil.which("gsettings"):
                custom_path = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/mp-magic-mouse/"
                subprocess.run(["gsettings", "reset-recursively", f"org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:{custom_path}"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        try:
            kde_desktop = os.path.expanduser("~/.local/share/applications/mp-magic-mouse-centered.desktop")
            if os.path.exists(kde_desktop):
                os.remove(kde_desktop)
            for kw in ["kwriteconfig6", "kwriteconfig5"]:
                if shutil.which(kw):
                    subprocess.run([kw, "--file", "kglobalshortcutsrc", "--group", "services",
                                    "--group", "mp-magic-mouse-centered.desktop", "--key", "_launch", "none,none,none"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    break
        except Exception:
            pass

    try:
        current_pid = os.getpid()
        if sys.platform != "win32":
            res = subprocess.run(["pgrep", "-f", f"{SCRIPT_PATH}.*--daemon"],
                                 capture_output=True, text=True)
            for line in res.stdout.strip().splitlines():
                try:
                    pid = int(line.strip())
                    if pid != current_pid:
                        os.kill(pid, signal.SIGTERM)
                except Exception:
                    pass
    except Exception:
        pass

    return success

def is_service_installed() -> bool:
    """Checks if background login service is installed."""
    if sys.platform == "darwin":
        return os.path.exists(MACOS_PLIST_PATH)
    elif sys.platform == "win32":
        try:
            import winreg
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, WINDOWS_REG_KEY, 0, winreg.KEY_READ) as key:
                winreg.QueryValueEx(key, WINDOWS_REG_NAME)
                return True
        except Exception:
            return False
    else:
        return os.path.exists(LINUX_SYSTEMD_PATH) or os.path.exists(LINUX_AUTOSTART_PATH)

def is_service_running() -> bool:
    """Checks if daemon process is currently running."""
    try:
        current_pid = os.getpid()
        if sys.platform != "win32":
            res = subprocess.run(["pgrep", "-f", f"{SCRIPT_PATH}.*--daemon"], capture_output=True, text=True)
            pids = [int(p) for p in res.stdout.strip().splitlines() if p.strip() and int(p) != current_pid]
            return len(pids) > 0
        else:
            out = subprocess.check_output('tasklist /FI "IMAGENAME eq python.exe" /FI "IMAGENAME eq pythonw.exe"',
                                          shell=True, text=True, stderr=subprocess.DEVNULL)
            return "python" in out.lower()
    except Exception:
        return False

