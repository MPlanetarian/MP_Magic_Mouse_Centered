def ensure_sound_file() -> str:
    """Generates the cheerful chime sound if not already present."""
    if os.path.exists(SOUND_FILE):
        return SOUND_FILE

    os.makedirs(ASSETS_DIR, exist_ok=True)
    sample_rate = 44100
    notes = [
        (1046.50, 0.075, 0.50), # C6
        (1318.51, 0.075, 0.60), # E6
        (1567.98, 0.075, 0.70), # G6
        (2093.00, 0.380, 0.85), # C7
    ]
    samples = []
    for freq, dur, vol in notes:
        n = int(sample_rate * dur)
        for i in range(n):
            t = i / sample_rate
            attack = min(1.0, t / 0.003)
            decay = math.exp(-3.8 * (t / dur))
            env = attack * decay * vol
            val = math.sin(2 * math.pi * freq * t) + 0.22 * math.sin(4 * math.pi * freq * t)
            sample = int(val * env * 32767 * 0.75)
            samples.append(max(-32767, min(32767, sample)))

    try:
        with wave.open(SOUND_FILE, "wb") as f:
            f.setnchannels(1)
            f.setsampwidth(2)
            f.setframerate(sample_rate)
            f.writeframes(struct.pack(f"<{len(samples)}h", *samples))
    except Exception:
        pass
    return SOUND_FILE

def play_happy_sound():
    """Plays the generated happy alert sound without logging or console output."""
    sound_path = ensure_sound_file()
    if not os.path.exists(sound_path):
        return

    try:
        if sys.platform == "darwin":
            subprocess.run(["afplay", sound_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif sys.platform == "win32":
            try:
                import winsound
                winsound.PlaySound(sound_path, winsound.SND_FILENAME)
            except Exception:
                subprocess.run(
                    ["powershell", "-c", f'(New-Object Media.SoundPlayer "{sound_path}").PlaySync()'],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
        else: # Linux
            for player in ["aplay", "paplay", "pw-play", "canberra-gtk-play", "ffplay"]:
                if shutil.which(player):
                    cmd = [player, "-f", sound_path] if player == "canberra-gtk-play" else [player, sound_path]
                    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    break
    except Exception:
        pass

