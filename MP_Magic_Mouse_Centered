def get_monitors_macos() -> List[Dict[str, Any]]:
    class CGPoint(ctypes.Structure):
        _fields_ = [('x', ctypes.c_double), ('y', ctypes.c_double)]
    class CGSize(ctypes.Structure):
        _fields_ = [('width', ctypes.c_double), ('height', ctypes.c_double)]
    class CGRect(ctypes.Structure):
        _fields_ = [('origin', CGPoint), ('size', CGSize)]

    try:
        cg = ctypes.cdll.LoadLibrary('/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices')
        cg.CGMainDisplayID.restype = ctypes.c_uint32
        cg.CGDisplayBounds.restype = CGRect
        cg.CGDisplayBounds.argtypes = [ctypes.c_uint32]
        cg.CGGetActiveDisplayList.argtypes = [ctypes.c_uint32, ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(ctypes.c_uint32)]

        main_id = cg.CGMainDisplayID()
        count = ctypes.c_uint32(0)
        displays = (ctypes.c_uint32 * 32)()
        cg.CGGetActiveDisplayList(32, displays, ctypes.byref(count))

        monitors = []
        for i in range(count.value):
            d_id = int(displays[i])
            b = cg.CGDisplayBounds(d_id)
            is_main = (d_id == main_id)
            monitors.append({
                "index": i,
                "id": d_id,
                "name": f"Display {i} (ID: {d_id})" + (" [Main Display]" if is_main else ""),
                "is_primary": is_main,
                "x": int(b.origin.x),
                "y": int(b.origin.y),
                "width": int(b.size.width),
                "height": int(b.size.height),
                "center_x": int(b.origin.x + b.size.width / 2.0),
                "center_y": int(b.origin.y + b.size.height / 2.0),
            })
        if monitors:
            return monitors
    except Exception:
        pass

    return [{
        "index": 0, "id": 1, "name": "Primary Display", "is_primary": True,
        "x": 0, "y": 0, "width": 1920, "height": 1080, "center_x": 960, "center_y": 540
    }]

def center_mouse_macos(x: float, y: float, display_id: Optional[int] = None) -> bool:
    """
    Visibly positions the mouse cursor at (x, y) on macOS.
    1. Uses cliclick if installed (gold standard native Cocoa tool).
    2. Uses native CoreGraphics with zero-delta event post, cursor unhiding, and warp.
    """
    target_x = int(round(x))
    target_y = int(round(y))

    success = False

    # Method 1: cliclick (handles remote desktop sessions like NoMachine & all displays)
    cliclick_bins = [
        shutil.which("cliclick"),
        "/opt/homebrew/bin/cliclick",
        "/usr/local/bin/cliclick"
    ]
    for c_bin in cliclick_bins:
        if c_bin and os.path.exists(c_bin):
            try:
                res = subprocess.run([c_bin, f"m:{target_x},{target_y}"],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if res.returncode == 0:
                    success = True
                    break
            except Exception:
                pass

    # Method 2 & Unhide: Native CoreGraphics
    class CGPoint(ctypes.Structure):
        _fields_ = [('x', ctypes.c_double), ('y', ctypes.c_double)]

    try:
        cg = ctypes.cdll.LoadLibrary('/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices')
        cf = ctypes.cdll.LoadLibrary('/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation')

        if display_id is None:
            cg.CGMainDisplayID.restype = ctypes.c_uint32
            display_id = cg.CGMainDisplayID()

        pt = CGPoint(float(target_x), float(target_y))

        cg.CGSetLocalEventsSuppressionInterval.argtypes = [ctypes.c_double]
        cg.CGSetLocalEventsSuppressionInterval.restype = ctypes.c_int32
        cg.CGSetLocalEventsSuppressionInterval(0.0)

        cg.CGAssociateMouseAndMouseCursorPosition.argtypes = [ctypes.c_bool]
        cg.CGAssociateMouseAndMouseCursorPosition.restype = ctypes.c_int32
        cg.CGAssociateMouseAndMouseCursorPosition(True)

        cg.CGDisplayMoveCursorToPoint.argtypes = [ctypes.c_uint32, CGPoint]
        cg.CGDisplayMoveCursorToPoint.restype = ctypes.c_int32
        cg.CGDisplayMoveCursorToPoint(ctypes.c_uint32(display_id), pt)

        cg.CGWarpMouseCursorPosition.argtypes = [CGPoint]
        cg.CGWarpMouseCursorPosition.restype = ctypes.c_int32
        cg.CGWarpMouseCursorPosition(pt)

        # Unhide cursor in case keyboard typing hid it
        cg.CGDisplayShowCursor.argtypes = [ctypes.c_uint32]
        cg.CGDisplayShowCursor.restype = ctypes.c_int32
        cg.CGDisplayShowCursor(0)

        cg.CGEventCreateMouseEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint32, CGPoint, ctypes.c_uint32]
        cg.CGEventCreateMouseEvent.restype = ctypes.c_void_p
        cg.CGEventSetIntegerValueField.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int64]
        cg.CGEventPost.argtypes = [ctypes.c_uint32, ctypes.c_void_p]
        cf.CFRelease.argtypes = [ctypes.c_void_p]

        ev = cg.CGEventCreateMouseEvent(None, 5, pt, 0)
        if ev:
            cg.CGEventSetIntegerValueField(ev, 4, 0) # deltaX = 0
            cg.CGEventSetIntegerValueField(ev, 5, 0) # deltaY = 0
            cg.CGEventPost(0, ev)
            cf.CFRelease(ev)

        success = True
    except Exception:
        pass

    return success

def get_monitors_windows() -> List[Dict[str, Any]]:
    monitors = []
    try:
        user32 = ctypes.windll.user32
        class RECT(ctypes.Structure):
            _fields_ = [('left', ctypes.c_long), ('top', ctypes.c_long), ('right', ctypes.c_long), ('bottom', ctypes.c_long)]
        class MONITORINFOEXW(ctypes.Structure):
            _fields_ = [
                ('cbSize', ctypes.c_ulong),
                ('rcMonitor', RECT),
                ('rcWork', RECT),
                ('dwFlags', ctypes.c_ulong),
                ('szDevice', ctypes.c_wchar * 32)
            ]
        MONITORENUMPROC = ctypes.WINFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(RECT), ctypes.c_void_p)

        def enum_proc(hMonitor, hdcMonitor, lprcMonitor, dwData):
            mi = MONITORINFOEXW()
            mi.cbSize = ctypes.sizeof(MONITORINFOEXW)
            if user32.GetMonitorInfoW(hMonitor, ctypes.byref(mi)):
                is_primary = bool(mi.dwFlags & 1)
                rc = mi.rcMonitor
                w = rc.right - rc.left
                h = rc.bottom - rc.top
                monitors.append({
                    "index": len(monitors),
                    "id": len(monitors),
                    "name": mi.szDevice or f"Display {len(monitors)}",
                    "is_primary": is_primary,
                    "x": int(rc.left),
                    "y": int(rc.top),
                    "width": int(w),
                    "height": int(h),
                    "center_x": int(rc.left + w // 2),
                    "center_y": int(rc.top + h // 2)
                })
            return 1

        proc = MONITORENUMPROC(enum_proc)
        user32.EnumDisplayMonitors(None, None, proc, 0)
    except Exception:
        pass

    if not monitors:
        try:
            w = ctypes.windll.user32.GetSystemMetrics(0)
            h = ctypes.windll.user32.GetSystemMetrics(1)
            monitors.append({
                "index": 0, "id": 0, "name": "Primary Display", "is_primary": True,
                "x": 0, "y": 0, "width": w, "height": h, "center_x": w // 2, "center_y": h // 2
            })
        except Exception:
            monitors.append({
                "index": 0, "id": 0, "name": "Primary Display", "is_primary": True,
                "x": 0, "y": 0, "width": 1920, "height": 1080, "center_x": 960, "center_y": 540
            })
    return monitors

def center_mouse_windows(x: float, y: float) -> bool:
    try:
        return bool(ctypes.windll.user32.SetCursorPos(int(x), int(y)))
    except Exception:
        return False

def get_monitors_linux() -> List[Dict[str, Any]]:
    import re
    monitors = []
    is_wayland = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("XDG_SESSION_TYPE") == "wayland")

    if is_wayland and shutil.which("hyprctl"):
        try:
            out = subprocess.check_output(["hyprctl", "monitors", "-j"], text=True, stderr=subprocess.DEVNULL)
            data = json.loads(out)
            for idx, m in enumerate(data):
                monitors.append({
                    "index": idx,
                    "id": m.get("id", idx),
                    "name": m.get("name", f"Display {idx}"),
                    "is_primary": bool(m.get("focused", idx == 0)),
                    "x": int(m.get("x", 0)),
                    "y": int(m.get("y", 0)),
                    "width": int(m.get("width", 1920)),
                    "height": int(m.get("height", 1080)),
                    "center_x": int(m.get("x", 0) + m.get("width", 1920) // 2),
                    "center_y": int(m.get("y", 0) + m.get("height", 1080) // 2),
                })
            if monitors:
                return monitors
        except Exception:
            pass

    if is_wayland and shutil.which("swaymsg"):
        try:
            out = subprocess.check_output(["swaymsg", "-t", "get_outputs"], text=True, stderr=subprocess.DEVNULL)
            data = json.loads(out)
            for idx, m in enumerate(data):
                rect = m.get("rect", {})
                monitors.append({
                    "index": idx,
                    "id": idx,
                    "name": m.get("name", f"Display {idx}"),
                    "is_primary": bool(m.get("primary", idx == 0)),
                    "x": int(rect.get("x", 0)),
                    "y": int(rect.get("y", 0)),
                    "width": int(rect.get("width", 1920)),
                    "height": int(rect.get("height", 1080)),
                    "center_x": int(rect.get("x", 0) + rect.get("width", 1920) // 2),
                    "center_y": int(rect.get("y", 0) + rect.get("height", 1080) // 2),
                })
            if monitors:
                return monitors
        except Exception:
            pass

    # KDE Plasma (Wayland / X11 via KScreen)
    if shutil.which("kscreen-doctor"):
        try:
            out = subprocess.check_output(["kscreen-doctor", "-j"], text=True, stderr=subprocess.DEVNULL)
            data = json.loads(out)
            outputs = data.get("outputs", [])
            for o in outputs:
                if not o.get("connected") or not o.get("enabled"):
                    continue
                name = o.get("name", f"Display {len(monitors)}")
                is_primary = (o.get("priority") == 1)
                pos = o.get("pos", {})
                size = o.get("size", {})
                scale = float(o.get("scale", 1.0)) or 1.0
                w = int(round(size.get("width", 1920) / scale))
                h = int(round(size.get("height", 1080) / scale))
                x = int(pos.get("x", 0))
                y = int(pos.get("y", 0))
                monitors.append({
                    "index": len(monitors),
                    "id": o.get("id", len(monitors)),
                    "name": name,
                    "is_primary": is_primary,
                    "x": x,
                    "y": y,
                    "width": w,
                    "height": h,
                    "scale": scale,
                    "center_x": x + w // 2,
                    "center_y": y + h // 2,
                })
            if monitors:
                if not any(m["is_primary"] for m in monitors):
                    monitors[0]["is_primary"] = True
                return monitors
        except Exception:
            pass

    if shutil.which("xrandr"):
        try:
            out = subprocess.check_output(["xrandr", "--query"], text=True, stderr=subprocess.DEVNULL)
            idx = 0
            for line in out.splitlines():
                if " connected" in line:
                    is_primary = " primary " in line
                    parts = line.split()
                    name = parts[0]
                    geom = None
                    for p in parts[1:]:
                        if "x" in p and "+" in p:
                            geom = p
                            break
                    if geom:
                        m = re.match(r"(\d+)x(\d+)\+(\d+)\+(\d+)", geom)
                        if m:
                            w, h, x, y = map(int, m.groups())
                            monitors.append({
                                "index": idx,
                                "id": idx,
                                "name": name,
                                "is_primary": is_primary,
                                "x": x,
                                "y": y,
                                "width": w,
                                "height": h,
                                "center_x": x + w // 2,
                                "center_y": y + h // 2,
                            })
                            idx += 1
            if monitors:
                if not any(m["is_primary"] for m in monitors):
                    monitors[0]["is_primary"] = True
                return monitors
        except Exception:
            pass

    try:
        for lib_name in ["libX11.so.6", "libX11.so"]:
            try:
                x11 = ctypes.cdll.LoadLibrary(lib_name)
                disp = x11.XOpenDisplay(None)
                if disp:
                    screen = x11.XDefaultScreen(disp)
                    w = x11.XDisplayWidth(disp, screen)
                    h = x11.XDisplayHeight(disp, screen)
                    x11.XCloseDisplay(disp)
                    return [{
                        "index": 0, "id": 0, "name": "Default Screen", "is_primary": True,
                        "x": 0, "y": 0, "width": w, "height": h, "center_x": w // 2, "center_y": h // 2
                    }]
            except Exception:
                continue
    except Exception:
        pass

    return [{
        "index": 0, "id": 0, "name": "Default Display", "is_primary": True,
        "x": 0, "y": 0, "width": 1920, "height": 1080, "center_x": 960, "center_y": 540
    }]

def center_mouse_linux(x: float, y: float) -> bool:
    is_wayland = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("XDG_SESSION_TYPE") == "wayland")
    target_x = int(round(x))
    target_y = int(round(y))

    if is_wayland:
        if shutil.which("ydotool"):
            env = os.environ.copy()
            uid = os.getuid()
            if "YDOTOOL_SOCKET" not in env:
                for sock in [f"/run/user/{uid}/.ydotool_socket", "/tmp/.ydotool_socket"]:
                    if os.path.exists(sock):
                        env["YDOTOOL_SOCKET"] = sock
                        break
            res = subprocess.run(["ydotool", "mousemove", "-a", str(target_x), str(target_y)],
                                 env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                return True

        if shutil.which("hyprctl"):
            res = subprocess.run(["hyprctl", "dispatch", "movecursor", f"{target_x} {target_y}"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                return True

        if shutil.which("wlrctl"):
            res = subprocess.run(["wlrctl", "pointer", "move", str(target_x), str(target_y)],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                return True

        if shutil.which("kdotool"):
            res = subprocess.run(["kdotool", "mousemove", str(target_x), str(target_y)],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                return True

    for lib_name in ["libX11.so.6", "libX11.so"]:
        try:
            x11 = ctypes.cdll.LoadLibrary(lib_name)
            x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
            x11.XOpenDisplay.restype = ctypes.c_void_p
            x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
            x11.XDefaultRootWindow.restype = ctypes.c_ulong
            x11.XWarpPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint, ctypes.c_int, ctypes.c_int]
            x11.XWarpPointer.restype = ctypes.c_int
            x11.XFlush.argtypes = [ctypes.c_void_p]
            x11.XFlush.restype = ctypes.c_int
            x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
            x11.XCloseDisplay.restype = ctypes.c_int

            disp = x11.XOpenDisplay(None)
            if disp:
                root = x11.XDefaultRootWindow(disp)
                x11.XWarpPointer(disp, 0, root, 0, 0, 0, 0, target_x, target_y)
                x11.XFlush(disp)
                x11.XCloseDisplay(disp)
                return True
        except Exception:
            continue

    if shutil.which("xdotool"):
        res = subprocess.run(["xdotool", "mousemove", str(target_x), str(target_y)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0:
            return True

    return False

def get_monitors() -> List[Dict[str, Any]]:
    if sys.platform == "darwin":
        return get_monitors_macos()
    elif sys.platform == "win32":
        return get_monitors_windows()
    else:
        return get_monitors_linux()

def get_target_monitor(config: Dict[str, Any]) -> Dict[str, Any]:
    monitors = get_monitors()
    if not monitors:
        return {
            "index": 0, "name": "Default Display", "is_primary": True,
            "x": 0, "y": 0, "width": 1920, "height": 1080, "center_x": 960, "center_y": 540
        }

    target_pref = str(config.get("target_monitor", "primary")).strip()

    if target_pref.lower() == "primary":
        for m in monitors:
            if m.get("is_primary"):
                return m
        return monitors[0]

    try:
        idx = int(target_pref)
        for m in monitors:
            if m.get("index") == idx:
                return m
    except (ValueError, TypeError):
        pass

    clean_pref = target_pref.lower().replace("-", "").replace("_", "").replace(" ", "")
    for m in monitors:
        m_name = str(m.get("name", "")).lower().replace("-", "").replace("_", "").replace(" ", "")
        m_id = str(m.get("id", "")).lower()
        if m_name == clean_pref or m_id == target_pref.lower() or str(m.get("name", "")).lower() == target_pref.lower():
            return m

    for m in monitors:
        if m.get("is_primary"):
            return m
    return monitors[0]

def center_cursor(config: Optional[Dict[str, Any]] = None) -> Tuple[bool, Dict[str, Any]]:
    """Centers the mouse cursor on the configured target monitor."""
    if config is None:
        config = load_config()
    target = get_target_monitor(config)
    cx, cy = target["center_x"], target["center_y"]
    display_id = target.get("id")

    if sys.platform == "darwin":
        success = center_mouse_macos(cx, cy, display_id=display_id)
    elif sys.platform == "win32":
        success = center_mouse_windows(cx, cy)
    else:
        success = center_mouse_linux(cx, cy)

    return success, target

