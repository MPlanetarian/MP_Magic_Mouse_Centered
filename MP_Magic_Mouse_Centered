def handle_first_run(config: Dict[str, Any]) -> bool:
    """
    Executes first-run initialization:
    - Centers mouse cursor immediately
    - Displays required first-time message
    - Plays generated happy alert sound
    - Automatically installs permanent background service
    """
    success, target = center_cursor(config)

    message = "You will never need to find your Mouse Cursor every again because it will always be in the Center of your Primary Screen when you login to your Desktop."
    print("\n" + "=" * 80)
    print(message)
    print("=" * 80 + "\n")

    play_happy_sound()

    print("[+] Automatically installing permanent background service...")
    installed = install_background_service()
    config["first_run_completed"] = True
    config["service_installed"] = installed
    save_config(config)

    if installed:
        print("[+] Permanent background service successfully installed and activated!")
        print("[+] Mouse cursor will automatically center on login.")
        print("[+] Global shortcut ALT+C is now active for instant centering.")
    else:
        print("[!] Background service installation encountered an issue. You can manage it from the menu.")

    print(f"\n[OK] Centered on: {target.get('name', 'Primary Display')} ({target.get('width')}x{target.get('height')})")
    print(f"[OK] Configuration saved to: {get_config_path()}\n")
    return True

