SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SCRIPT_PATH = os.path.abspath(__file__)
ASSETS_DIR = os.path.join(SCRIPT_DIR, "assets")
SOUND_FILE = os.path.join(ASSETS_DIR, "happy_alert.wav")
LOCAL_CONFIG_FILE = os.path.join(SCRIPT_DIR, "config.json")

def get_config_path() -> str:
    """Returns local config if writable or already present; otherwise user config dir."""
    if os.path.exists(LOCAL_CONFIG_FILE):
        return LOCAL_CONFIG_FILE
    try:
        with open(LOCAL_CONFIG_FILE, "a"):
            pass
        return LOCAL_CONFIG_FILE
    except (OSError, PermissionError):
        pass

    if sys.platform == "win32":
        app_data = os.environ.get("APPDATA", os.path.expanduser("~"))
        base_dir = os.path.join(app_data, "MP_Magic_Mouse_Centered")
    else:
        base_dir = os.path.expanduser("~/.config/mp_magic_mouse_centered")
    os.makedirs(base_dir, exist_ok=True)
    return os.path.join(base_dir, "config.json")

DEFAULT_CONFIG: Dict[str, Any] = {
    "target_monitor": "primary",
    "first_run_completed": False,
    "service_installed": False,
    "sound_enabled": True,
    "sound_on_hotkey": False,
    "shortcut": "Alt+C"
}

def load_config() -> Dict[str, Any]:
    config_path = get_config_path()
    if os.path.exists(config_path):
        try:
            with open(config_path, "r", encoding="utf-8") as f:
                cfg = json.load(f)
                for k, v in DEFAULT_CONFIG.items():
                    if k not in cfg:
                        cfg[k] = v
                return cfg
        except Exception:
            pass
    return DEFAULT_CONFIG.copy()

def save_config(config: Dict[str, Any]) -> bool:
    config_path = get_config_path()
    try:
        os.makedirs(os.path.dirname(os.path.abspath(config_path)), exist_ok=True)
        with open(config_path, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=4)
        return True
    except Exception:
        return False

